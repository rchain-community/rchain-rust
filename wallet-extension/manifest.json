{
  "manifest_version": 3,
  "name": "REV Wallet (dev build)",
  "version": "0.1.0",
  "description": "Least-authority RChain deploy signing: a page can request one signature at a time, approved explicitly here - it never holds the key.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:5174/*",
        "http://127.0.0.1:5175/*",
        "http://127.0.0.1:5176/*",
        "http://127.0.0.1:5177/*",
        "http://127.0.0.1:5178/*",
        "http://127.0.0.1:5199/*",
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://localhost:5175/*",
        "http://localhost:5176/*",
        "http://localhost:5177/*",
        "http://localhost:5178/*",
        "http://localhost:5199/*"
      ],
      "js": ["content-script.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:5174/*",
        "http://127.0.0.1:5175/*",
        "http://127.0.0.1:5176/*",
        "http://127.0.0.1:5177/*",
        "http://127.0.0.1:5178/*",
        "http://127.0.0.1:5199/*",
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://localhost:5175/*",
        "http://localhost:5176/*",
        "http://localhost:5177/*",
        "http://localhost:5178/*",
        "http://localhost:5199/*"
      ],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "REV Wallet"
  }
}
